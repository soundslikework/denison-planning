---
import { services } from "../data/services";
import ServiceIcon from "./ServiceIcon.astro";
---

<section class="bg-paper text-ink">
  <div class="max-w-7xl mx-auto px-6 md:px-8 py-20 md:py-28">
    <h2 class="font-display text-xs uppercase tracking-widest text-teal">
      What We Do
    </h2>
    <div class="mt-2 h-0.5 w-10 bg-teal"></div>
    <div class="mt-12 grid md:grid-cols-2 gap-x-16">
      {
        services.map((service) => (
          <div class="flex gap-6 py-6 border-b border-ink/10">
            <div class="flex flex-col items-center gap-2 shrink-0">
              <span class="font-display text-2xl font-bold text-teal shrink-0">
                {service.number}
              </span>
              <div class="text-teal mb-2">
                <ServiceIcon name={service.icon} />
              </div>
            </div>
            <div>
              <h3 class="font-display font-bold uppercase text-sm tracking-wide">
                {service.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/80">
                {service.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
