---
// Small teal eyebrow heading with a short rule beneath it — the on-paper
// section marker used by "What We Do" on the homepage and by section
// headings on interior pages.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={className}>
  <h2 class="font-display text-xs uppercase tracking-widest text-teal">
    <slot />
  </h2>
  <div class="mt-2 h-0.5 w-10 bg-teal"></div>
</div>
