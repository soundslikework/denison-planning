---
import { Image } from 'astro:assets';
import Header from './Header.astro';
import heroImage from '../assets/hero-toronto-skyline.jpg';
---

<section class="relative isolate bg-teal text-gold overflow-hidden">
  <Image
    src={heroImage}
    alt=""
    class="absolute inset-0 size-full object-cover"
    loading="eager"
  />
  <!-- Teal duotone: mix-blend-color keeps the photo's luminance but takes the
       brand hue, matching the mockup's graded look. The scrim above it stays
       near-solid teal through the text zone to protect contrast, then opens
       up toward the bottom so the skyline reads. -->
  <div class="absolute inset-0 bg-teal mix-blend-color" aria-hidden="true"></div>
  <div
    class="absolute inset-0 bg-linear-to-b from-teal via-teal/90 to-teal/50"
    aria-hidden="true"
  >
  </div>
  <div class="relative">
    <Header />
    <div class="max-w-7xl mx-auto px-6 md:px-8 pt-32 pb-40 md:pt-48 md:pb-52">
      <h1 class="font-display font-bold text-5xl md:text-7xl lg:text-8xl leading-none tracking-tight max-w-5xl">
        Planning for<br />places that work.
      </h1>
      <div class="mt-10 md:mt-20 font-body text-base md:text-lg leading-relaxed space-y-1">
        <p>Thoughtful planning.</p>
        <p>Strong neighbourhoods.</p>
        <p>Better places.</p>
      </div>
      <svg
        viewBox="0 0 144 16"
        fill="none"
        class="mt-6 w-28 md:w-36 text-gold"
        aria-hidden="true"
      >
        <path
          d="M1 10 C40 4 90 3 143 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    </div>
  </div>
</section>
