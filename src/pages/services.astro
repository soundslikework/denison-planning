---
import PageLayout from "../layouts/PageLayout.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import ContentContainer from "../components/ContentContainer.astro";
import { servicesPage } from "../data/servicesPage";
---

<PageLayout
  title="Services"
  description="Planning and development advisory, research and due diligence, development applications, planning reports, project management, community engagement and municipal policy planning."
  showCta={false}
>
  <section class="bg-paper text-ink">
    <ContentContainer class="py-20 md:py-28">
      <ul>
        {
          servicesPage.map((service) => (
            <li class="flex gap-6 md:gap-10 py-8 first:pt-0 border-b border-ink/10">
              <span class="font-display text-2xl md:text-3xl font-bold text-teal shrink-0">
                {service.number}
              </span>
              <div>
                <div class="text-teal mb-3">
                  <ServiceIcon name={service.icon} />
                </div>
                <h2 class="font-display font-bold uppercase text-base md:text-lg tracking-wide">
                  {service.title}
                </h2>
                <p class="mt-3 text-base leading-relaxed text-ink/80 max-w-prose">
                  {service.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </ContentContainer>
  </section>
</PageLayout>
